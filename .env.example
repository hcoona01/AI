# Environment Configuration Template
# Copy to .env for local runtime configuration (DO NOT COMMIT real secrets)

# Server & Environment
ENVIRONMENT=development
PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Persistence Store (gist | local)
STORE_BACKEND=local
GIST_TOKEN=ghp_example_github_token_with_gist_permission
GIST_ID=example_private_gist_id_here
LOCAL_DATA_DIR=data/store

# Security & Authentication
JWT_SECRET=super-secret-development-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_DEV_MODE=True
OTP_CODE_TTL_MINUTES=5

# SMTP / Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=mailer@university.edu
SMTP_PASS=example_smtp_password

# CORS & Frontend Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Frontend API Target (consumed by Vite)
VITE_API_URL=http://localhost:8000/api/v1

# Machine Learning & Demand Forecasting (model | precomputed)
FORECAST_MODE=model
