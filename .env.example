# Environment Configuration Template
# Copy to .env and provide local development values (DO NOT COMMIT .env)

# Backend Server Configuration
ENVIRONMENT=development
PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Security & Session
SECRET_KEY=change_this_to_a_secure_random_hex_key_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# GitHub Gist Persistence Store
GITHUB_GIST_TOKEN=ghp_example_token_with_gist_permission
GITHUB_GIST_ID=example_gist_id_here
USE_LOCAL_FALLBACK=True
LOCAL_DATA_DIR=data/seed

# Email OTP Configuration (Mocked locally in development)
MOCK_OTP_DELIVERY=True
OTP_CODE_TTL_MINUTES=10
